# ---- LLM agent (always required) ----
GROQ_API_KEY=

# ---- Provider selection ----
# TTS_PROVIDER: elevenlabs (default) | 60db
# STT_PROVIDER: groq (default)       | 60db
TTS_PROVIDER=elevenlabs
STT_PROVIDER=groq

# ---- ElevenLabs (required when TTS_PROVIDER=elevenlabs) ----
ELEVENLABS_API_KEY=
# Optional: override default ElevenLabs voice (defaults to ADAM)
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ---- 60db (required when TTS_PROVIDER=60db or STT_PROVIDER=60db) ----
SIXTYDB_API_KEY=
# Required when TTS_PROVIDER=60db. Get an id from GET /myvoices.
SIXTYDB_VOICE_ID=
# Optional overrides:
# SIXTYDB_BASE_URL=https://api.60db.ai
# SIXTYDB_TTS_OUTPUT_FORMAT=mp3
# SIXTYDB_STT_LANGUAGE=auto

# ---- OpenAI (optional, legacy STT path only) ----
# OPENAI_API_KEY=
